{
  "name": "hanzi-dictionary",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://kevinzhang2135.github.io/hanzi-dictionary",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
